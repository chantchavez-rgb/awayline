# Optional. Without these, development shows the login code on screen.
# Production will not send or reveal codes until all three are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional locally. When set, Awayline uses Postgres instead of data/awayline.sqlite.
# Vercel fills this in through the Neon integration.
DATABASE_URL=
